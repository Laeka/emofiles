{
    "layer": "top",
    "position": "top",
    "output": "DP-1",
    "height": 34,
    "spacing": 8,

    "modules-left": ["mpris"],
    "modules-center": ["hyprland/workspaces", "clock"],
    "modules-right": ["pulseaudio", "tray"],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "active": "",
            "default": "",
            "empty": ""
        },
        "persistent-workspaces": {
            "*": 4
        }
    },

    "clock": {
        "format": "{:%H:%M - %A %d}", 
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    "mpris": {
        "player": "spotify",
        "format": " {status_icon} {dynamic}",
        "dynamic-len": 40,
        "status-icons": {
            "playing": "▶",
            "paused": "⏸"
        }
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "  Mute",
        "format-icons": {
            "default": ["", "", ""]
        },
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    }
}
